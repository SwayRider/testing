meta {
  name: Send [S]
  type: http
  seq: 2
}

post {
  url: {{MAILSERVICE_HOST}}:{{MAILSERVICE_PORT}}/api/v1/mail/admin/send
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{access_token}}
}

body:json {
  {
    "from": "swayrider@hevanto-it.com",
    "to": ["{{USER_EMAIL}}"],
    "subject": "Test mail from SwayRider",
    "textBody": "This is a test mail"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
