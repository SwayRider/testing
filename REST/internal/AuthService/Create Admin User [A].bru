meta {
  name: Create Admin User [A]
  type: http
  seq: 6
}

post {
  url: {{AUTHSERVICE_HOST}}:{{AUTHSERVICE_PORT}}/api/v1/auth/create-admin
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{access_token}}
}

body:json {
  {
    "email": "{{USER_EMAIL}}",
    "password": "{{USER_PASSWORD}}"
  }
}
