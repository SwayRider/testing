meta {
  name: Change Password [L]
  type: http
  seq: 2
}

post {
  url: {{AUTHSERVICE_HOST}}:{{AUTHSERVICE_PORT}}/api/v1/auth/change-password
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{access_token}}
}

body:json {
  {
    "oldPassword": "{{USER_PASSWORD}}",
    "newPassword": "NewPassword123!"
  }
}
