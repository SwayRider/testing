meta {
  name: Register User [-]
  type: http
  seq: 3
}

post {
  url: {{AUTHSERVICE_HOST}}:{{AUTHSERVICE_PORT}}/api/v1/auth/register
  body: json
  auth: inherit
}

body:json {
  {
    "email": "{{USER_EMAIL}}",
    "password": "{{USER_PASSWORD}}",
    "verificationUrl": "{{AUTHSERVICE_HOST}}:{{AUTHSERVICE_WEB_PORT}}"
  }
}
