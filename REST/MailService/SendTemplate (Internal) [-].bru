meta {
  name: SendTemplate (Internal) [-]
  type: http
  seq: 4
}

post {
  url: {{MAILSERVICE_HOST}}:{{MAILSERVICE_PORT}}/api/v1/mail/internal/send-template
  body: json
  auth: inherit
}

body:json {
  {
    "from": "swayrider@example.com",
    "to": ["{{USER_EMAIL}}"],
    "subject": "Test mail from SwayRider",
    "html_template": "test.html",
    "text_template": "test.txt",
    "data": {
      "UserName": "Test User"
    }
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
