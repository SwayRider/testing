meta {
  name: Enable MFA [L]
  type: http
  seq: 2
}

post {
  url: {{AUTHSERVICE_HOST}}:{{AUTHSERVICE_PORT}}/api/v1/auth/mfa/enable
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{access_token}}
}

body:json {
  {
    "code": "{{mfa_code}}"
  }
}

script:post-response {
  if (res.status == 200 && res.body.backupCodes !== undefined) {
    bru.setVar("mfa_backup_codes", res.body.backupCodes.join(", "));
  }
}
