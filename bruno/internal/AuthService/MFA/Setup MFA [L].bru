meta {
  name: Setup MFA [L]
  type: http
  seq: 1
}

post {
  url: {{AUTHSERVICE_HOST}}:{{AUTHSERVICE_PORT}}/api/v1/auth/mfa/setup
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{access_token}}
}

body:json {
  {}
}

script:post-response {
  if (res.status == 200) {
    if (res.body.secret !== undefined) {
      bru.setVar("mfa_secret", res.body.secret);
    }
    if (res.body.otpauthUrl !== undefined) {
      bru.setVar("mfa_otpauth_url", res.body.otpauthUrl);
    }
  }
}
