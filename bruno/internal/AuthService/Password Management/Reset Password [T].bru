meta {
  name: Reset Password [T]
  type: http
  seq: 4
}

post {
  url: {{AUTHSERVICE_HOST}}:{{AUTHSERVICE_PORT}}/api/v1/auth/reset-password
  body: json
  auth: inherit
}

body:json {
  {
    "userId": "{{reset_password_user_id}}",
    "token": "{{reset_password_token}}",
    "newPassword": "NewPassword123!"
  }
}
