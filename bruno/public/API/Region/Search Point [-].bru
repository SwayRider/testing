meta {
  name: Search Point [-]
  type: http
  seq: 1
}

post {
  url: {{API_HOST}}:{{API_PORT}}/api/v1/region/search-point
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{access_token}}
}

body:json {
  {
    "location": {
      "lat": 42.90737207237733,
      "lon": 0.4849465967024218
    },
    "include_extended": true
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
