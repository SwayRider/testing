meta {
  name: Create Service Client [A]
  type: http
  seq: 1
}

post {
  url: {{API_HOST}}:{{API_PORT}}/api/v1/auth/admin/create-service-client
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{access_token}}
}

body:json {
  {
    "name": "{{SERVICE_CLIENT_NAME}}",
    "description": "{{SERVICE_CLIENT_DESCRIPTION}}",
    "scopes": ["region:query"]
  }
}

script:post-response {
  if (res.status == 200 && res.body.client_id !== undefined) {
    bru.setVar("service_client_id", res.body.client_id);
  }
}
