meta {
  name: Login (MFA enabled) [-]
  type: http
  seq: 4
}

post {
  url: {{API_HOST}}:{{API_PORT}}/api/v1/auth/login
  body: json
  auth: inherit
}

body:json {
  {
    "email": "{{USER_EMAIL}}",
    "password": "{{USER_PASSWORD}}",
    "remember_me": false
  }
}

script:post-response {
  if (res.status == 200 && res.body.mfa_required === true) {
    bru.setVar("mfa_token", res.body.mfa_token);
  }
}
