meta {
  name: Register [-]
  type: http
  seq: 2
}

post {
  url: {{API_HOST}}:{{API_PORT}}/api/v1/auth/register
  body: json
  auth: inherit
}

body:json {
  {
    "email": "{{REGISTER_EMAIL}}",
    "password": "{{USER_PASSWORD}}",
    "verification_url": "{{API_HOST}}:{{API_PORT}}/web/verify-user"
  }
}

script:post-response {
  if (res.status == 200 && res.body.user_id !== undefined) {
    bru.setVar("registered_user_id", res.body.user_id);
  }
}
