meta {
  name: Change Password [L]
  type: http
  seq: 3
}

post {
  url: {{API_HOST}}:{{API_PORT}}/api/v1/auth/change-password
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{access_token}}
}

body:json {
  {
    "old_password": "{{USER_PASSWORD}}",
    "new_password": "NewPassword123!"
  }
}
