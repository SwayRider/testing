meta {
  name: Reset Password [T]
  type: http
  seq: 2
}

post {
  url: {{API_HOST}}:{{API_PORT}}/api/v1/auth/reset-password
  body: json
  auth: inherit
}

body:json {
  {
    "user_id": "{{reset_password_user_id}}",
    "token": "{{reset_password_token}}",
    "new_password": "NewPassword123!"
  }
}
