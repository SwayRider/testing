meta {
  name: Who Is (Email) [A]
  type: http
  seq: 2
}

post {
  url: {{API_HOST}}:{{API_PORT}}/api/v1/auth/admin/whois
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{access_token}}
}

body:json {
  {
    "email": "{{USER_EMAIL}}"
  }
}

script:post-response {
  if (res.status == 200 && res.body.user_id !== undefined) {
    bru.setVar("subject_user_id", res.body.user_id);
  }
}
