meta {
  name: Create Admin User [A]
  type: http
  seq: 1
}

post {
  url: {{API_HOST}}:{{API_PORT}}/api/v1/auth/admin/create-admin
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{access_token}}
}

body:json {
  {
    "email": "{{NEW_ADMIN_EMAIL}}",
    "password": "{{USER_PASSWORD}}"
  }
}

script:post-response {
  if (res.status == 200 && res.body.user_id !== undefined) {
    bru.setVar("created_admin_user_id", res.body.user_id);
  }
}
