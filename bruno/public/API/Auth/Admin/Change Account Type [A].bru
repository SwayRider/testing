meta {
  name: Change Account Type [A]
  type: http
  seq: 4
}

post {
  url: {{API_HOST}}:{{API_PORT}}/api/v1/auth/admin/change-account-type
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{access_token}}
}

body:json {
  {
    "userId": "{{subject_user_id}}",
    "accountType": "premium"
  }
}
