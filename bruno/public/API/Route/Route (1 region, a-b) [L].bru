meta {
  name: Route (1 region, a-b) [L]
  type: http
  seq: 1
}

post {
  url: {{API_HOST}}:{{API_PORT}}/api/v1/route
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{access_token}}
}

body:json {
  {
    "from": {
      "lat": 51.1326016136591,
      "lon": 5.156528827039818
    },
    "to": {
      "lat": 51.03248531407108,
      "lon": 4.980005010100536
    },
    "vehicle": "motorcycle",
    "options": {
      "avoidTollRoads": false,
      "avoidHighways": false,
      "avoidFerries": false,
      "scenicPreference": 0.5
    }
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
